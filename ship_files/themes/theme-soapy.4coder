defcolor_back = 0xFF171121; // background colour

defcolor_text_default = 0xFFa5a5c9; // default text colour

// top bar colour
defcolor_bar = 0xFFc7acf2;
defcolor_bar_active = 0xFFFFFF00; // not sure what this is

// colour used for bar text
defcolor_base = 0xFF4a2f66;

// borders around the text window
defcolor_margin = 0xFF625675;
defcolor_margin_hover = defcolor_margin;
defcolor_margin_active = defcolor_bar;

// colours in the lists like "open file", "list commands", etc.
// the first colour is the border colour and the second is the background
defcolor_list_item = {defcolor_margin, defcolor_back};
defcolor_list_item_hover = {defcolor_margin_hover, defcolor_margin};
defcolor_list_item_active = {defcolor_margin_active, defcolor_margin};

// colour for the highlighting cursor, not sure what the second
// value is for
defcolor_cursor = {0xFF9adffc, 0xFFFF0000};

defcolor_at_cursor = defcolor_back;
defcolor_highlight_cursor_line = 0xFF1E1E1E;

defcolor_highlight = 0xFFDDEE00;

defcolor_mark = 0xFF494949;
defcolor_at_highlight = 0xFFFF44DD;

// colour used in text during commands
defcolor_pop1 = defcolor_bar;

// colour used in buffers for extra text (like *loaded* while opening)
defcolor_pop2 = 0xFF726296;

//-----------------------------------------
// Text editor colours
//-----------------------------------------

defcolor_comment = 0xFF63638a;
defcolor_comment_pop = {0xFF00A000, 0xFFA00000};

defcolor_keyword = 0xFFd68ced;

defcolor_str_constant = 0xFF70dbff;
defcolor_char_constant = defcolor_str_constant;
defcolor_int_constant = defcolor_str_constant;
defcolor_float_constant = defcolor_str_constant;
defcolor_bool_constant = defcolor_str_constant;

defcolor_include = defcolor_str_constant;
defcolor_preproc = 0xFF8f8fcf;
defcolor_special_character = 0xFFFF0000;
defcolor_ghost_character = 0xFF4E5E46;

defcolor_paste = defcolor_keyword_keyword;

defcolor_undo = 0xFF00DDEE;

defcolor_highlight_junk = 0xff3a0000;
defcolor_highlight_white = 0xff003a3a;

defcolor_back_cycle = {0x10A00000, 0x0C00A000, 0x0C0000A0, 0x0CA0A000};
defcolor_text_cycle = {0xFFA00000, 0xFF00A000, 0xFF0030B0, 0xFFA0A000};

defcolor_line_numbers_back = 0xFF101010;
defcolor_line_numbers_text = 0xFF404040;

